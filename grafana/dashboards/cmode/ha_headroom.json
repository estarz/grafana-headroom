   "title": "Overall HA headroom",
   "type": "row"
  },
  {
   "datasource": "${DS_PROMETHEUS}",
   "description": "Worst of CPU risk and port risk. 0 green / 1 yellow / 2 red. Uses 95th percentile over $Window. CPU uses PCU when min confidence \u2265 2, else sum of node_cpu_busy.",
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "thresholds"
     },
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "OK \u2014 takeover headroom",
         "color": "green"
        }
       }
      },
      {
       "type": "range",
       "options": {
        "from": 0.5,
        "to": 1.5,
        "result": {
         "text": "Latency risk",
         "color": "yellow"
        }
       }
      },
      {
       "type": "range",
       "options": {
        "from": 1.5,
        "to": 9,
        "result": {
         "text": "Service interruption risk",
         "color": "red"
        }
       }
      }
     ],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "yellow",
        "value": 1
       },
       {
        "color": "red",
        "value": 2
       }
      ]
     },
     "unit": "short"
    },
    "overrides": []
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 0,
    "y": 1
   },
   "id": 2,
   "options": {
    "colorMode": "background",
    "graphMode": "area",
    "justifyMode": "auto",
    "orientation": "auto",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "textMode": "auto"
   },
   "pluginVersion": "8.1.8",
   "targets": [
    {
     "datasource": "${DS_PROMETHEUS}",
     "exemplar": false,
     "expr": "max by (cluster) (((\n  ((min by (cluster) (headroom_cpu_optimal_point_confidence_factor{datacenter=~\"$Datacenter\",cluster=~\"$Cluster\"})) >= bool 2)\n  *\n  clamp_max(\n    (((quantile_over_time(0.95, (sum by (cluster) (\n  100 *\n    headroom_cpu_current_utilization{datacenter=~\"$Datacenter\",cluster=~\"$Cluster\"}\n    /\n    clamp_min(headroom_cpu_optimal_point_utilization{datacenter=~\"$Datacenter\",cluster=~\"$Cluster\"}, 1e-3)\n))[$Window:])) >= bool 160) + ((quantile_over_time(0.95, (sum by (cluster) (\n  100 *\n    headroom_cpu_current_utilization{datacenter=~\"$Datacenter\",cluster=~\"$Cluster\"}\n    /\n    clamp_min(headroom_cpu_optimal_point_utilization{datacenter=~\"$Datacenter\",cluster=~\"$Cluster\"}, 1e-3)\n))[$Window:])) >= bool 200)),\n    2\n  )\n)\n+\n(\n  ((min by (cluster) (headroom_cpu_optimal_point_confidence_factor{datacenter=~\"$Datacenter\",cluster=~\"$Cluster\"})) < bool 2)\n  *\n  clamp_max(\n    (((quantile_over_time(0.95, (sum by (cluster) (node_cpu_busy{datacenter=~\"$Datacenter\",cluster=~\"$Cluster\"}))[$Window:])) >= bool 70) + ((quantile_over_time(0.95, (sum by (cluster) (node_cpu_busy{datacenter=~\"$Datacenter\",cluster=~\"$Cluster\"}))[$Window:])) >= bool 85)),\n    2\n  )\n)) or (clamp_max(\n  ((max by (cluster) (\n  (quantile_over_time(0.95, (max by (cluster) (sum by (cluster, nic) (nic_util_percent{datacenter=~\"$Datacenter\",cluster=~\"$Cluster\",nic!~\"$ExcludePorts\"}) * 100))[$Window:]))\n  or (quantile_over_time(0.95, (max by (cluster) (sum by (cluster, ifgroup) ((\n  nic_ifgrp_rx_perc{datacenter=~\"$Datacenter\",cluster=~\"$Cluster\",ports!=\"\"}\n  + nic_ifgrp_tx_perc{datacenter=~\"$Datacenter\",cluster=~\"$Cluster\",ports!=\"\"}\n  + abs(nic_ifgrp_rx_perc{datacenter=~\"$Datacenter\",cluster=~\"$Cluster\",ports!=\"\"} - nic_ifgrp_tx_perc{datacenter=~\"$Datacenter\",cluster=~\"$Cluster\",ports!=\"\"})\n) / 2 * 100)))[$Window:]))\n  or (quantile_over_time(0.95, (max by (cluster) (sum by (cluster, port) (fcp_util_percent{datacenter=~\"$Datacenter\",cluster=~\"$Cluster\"}) * 100))[$Window:]))\n)) >= bool 70) + ((max by (cluster) (\n  (quantile_over_time(0.95, (max by (cluster) (sum by (cluster, nic) (nic_util_percent{datacenter=~\"$Datacenter\",cluster=~\"$Cluster\",nic!~\"$ExcludePorts\"}) * 100))[$Window:]))\n  or (quantile_over_time(0.95, (max by (cluster) (sum by (cluster, ifgroup) ((\n  nic_ifgrp_rx_perc{datacenter=~\"$Datacenter\",cluster=~\"$Cluster\",ports!=\"\"}\n  + nic_ifgrp_tx_perc{datacenter=~\"$Datacenter\",cluster=~\"$Cluster\",ports!=\"\"}\n  + abs(nic_ifgrp_rx_perc{datacenter=~\"$Datacenter\",cluster=~\"$Cluster\",ports!=\"\"} - nic_ifgrp_tx_perc{datacenter=~\"$Datacenter\",cluster=~\"$Cluster\",ports!=\"\"})\n) / 2 * 100)))[$Window:]))\n  or (quantile_over_time(0.95, (max by (cluster) (sum by (cluster, port) (fcp_util_percent{datacenter=~\"$Datacenter\",cluster=~\"$Cluster\"}) * 100))[$Window:]))\n)) >= bool 85),\n  2\n)))",
     "interval": "",
     "legendFormat": "{{cluster}}",
     "refId": "A",
     "instant": true
    }
   ],
